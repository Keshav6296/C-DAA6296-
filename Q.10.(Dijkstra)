#include <iostream>
#include <vector>
#include <queue>
#include <climits>
using namespace std;

void dijkstra(vector<vector<pair<int,int>>>& adj, int src, int n) {
    vector<int> dist(n, INT_MAX);
    priority_queue<pair<int,int>, vector<pair<int,int>>, greater<>> pq;
    dist[src] = 0;
    pq.push({0, src});

    while (!pq.empty()) {
        auto [d, u] = pq.top(); pq.pop();
        if (d > dist[u]) continue;
        for (auto [v, w] : adj[u])
            if (dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                pq.push({dist[v], v});
            }
    }

    cout << "Shortest distances from node " << src << ":\n";
    for (int i = 0; i < n; i++)
        cout << "  To " << i << ": " << (dist[i] == INT_MAX ? -1 : dist[i]) << "\n";
}

int main() {
    int n = 5;
    vector<vector<pair<int,int>>> adj(n);
    auto addEdge = [&](int u, int v, int w) {
        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    };
    addEdge(0,1,10); addEdge(0,2,3); addEdge(1,3,2);
    addEdge(2,1,4);  addEdge(2,3,8); addEdge(2,4,2); addEdge(3,4,5);
    dijkstra(adj, 0, n);
}
