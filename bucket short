#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

void bucketSort(vector<float>& arr) {
    int n = arr.size();
    vector<vector<float>> buckets(n);
    for (float x : arr) buckets[(int)(n * x)].push_back(x);
    for (auto& b : buckets) sort(b.begin(), b.end());
    int idx = 0;
    for (auto& b : buckets)
        for (float x : b) arr[idx++] = x;
}

int main() {
    // Values must be in [0, 1)
    vector<float> arr = {0.78f, 0.17f, 0.39f, 0.26f, 0.72f, 0.94f, 0.21f, 0.12f};
    cout << "Before: ";
    for (float x : arr) cout << x << " ";
    bucketSort(arr);
    cout << "\nAfter:  ";
    for (float x : arr) cout << x << " ";
    cout << endl;
}
