#include <iostream>
#include <vector>
#include <climits>
using namespace std;

void primMST(vector<vector<pair<int,int>>>& adj, int n) {
    vector<int> key(n, INT_MAX), parent(n, -1);
    vector<bool> inMST(n, false);
    key[0] = 0;

    for (int count = 0; count < n - 1; count++) {
        // Pick min key vertex not in MST
        int u = -1;
        for (int v = 0; v < n; v++)
            if (!inMST[v] && (u == -1 || key[v] < key[u])) u = v;
        inMST[u] = true;
        for (auto [v, w] : adj[u])
            if (!inMST[v] && w < key[v]) { key[v] = w; parent[v] = u; }
    }

    cout << "Edge\tWeight\n";
    int total = 0;
    for (int i = 1; i < n; i++) {
        cout << parent[i] << " - " << i << "\t" << key[i] << "\n";
        total += key[i];
    }
    cout << "Total MST weight: " << total << endl;
}

int main() {
    int n = 5;
    vector<vector<pair<int,int>>> adj(n);
    auto addEdge = [&](int u, int v, int w) {
        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    };
    addEdge(0,1,2); addEdge(0,3,6); addEdge(1,2,3);
    addEdge(1,3,8); addEdge(1,4,5); addEdge(2,4,7); addEdge(3,4,9);
    primMST(adj, n);
}
