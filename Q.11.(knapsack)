#include <iostream>
#include <vector>
using namespace std;

int knapsack(int W, vector<int>& wt, vector<int>& val, int n) {
    vector<vector<int>> dp(n + 1, vector<int>(W + 1, 0));
    for (int i = 1; i <= n; i++)
        for (int w = 0; w <= W; w++) {
            dp[i][w] = dp[i-1][w];
            if (wt[i-1] <= w)
                dp[i][w] = max(dp[i][w], dp[i-1][w - wt[i-1]] + val[i-1]);
        }

    // Trace back selected items
    cout << "Selected items: ";
    int w = W;
    for (int i = n; i > 0; i--)
        if (dp[i][w] != dp[i-1][w]) {
            cout << "Item" << i << "(w=" << wt[i-1] << ",v=" << val[i-1] << ") ";
            w -= wt[i-1];
        }
    cout << "\n";
    return dp[n][W];
}

int main() {
    int W = 50;
    vector<int> wt = {10, 20, 30};
    vector<int> val = {60, 100, 120};
    int n = wt.size();
    cout << "Knapsack capacity: " << W << "\n";
    cout << "Maximum value: " << knapsack(W, wt, val, n) << endl;
}
