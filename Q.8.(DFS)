#include <iostream>
#include <vector>
using namespace std;

void dfs(vector<vector<int>>& adj, vector<bool>& visited, int node) {
    visited[node] = true;
    cout << node << " ";
    for (int neighbor : adj[node])
        if (!visited[neighbor])
            dfs(adj, visited, neighbor);
}

int main() {
    int n = 6;
    vector<vector<int>> adj(n);
    adj[0] = {1, 2}; adj[1] = {0, 3, 4};
    adj[2] = {0, 5}; adj[3] = {1};
    adj[4] = {1};    adj[5] = {2};
    vector<bool> visited(n, false);
    cout << "DFS traversal: ";
    dfs(adj, visited, 0);
    cout << endl;
}
