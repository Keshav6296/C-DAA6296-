#include <iostream>
#include <vector>
#include <queue>
using namespace std;

void bfs(vector<vector<int>>& adj, int start, int n) {
    vector<bool> visited(n, false);
    queue<int> q;
    visited[start] = true;
    q.push(start);
    cout << "BFS traversal: ";
    while (!q.empty()) {
        int node = q.front(); q.pop();
        cout << node << " ";
        for (int neighbor : adj[node]) {
            if (!visited[neighbor]) {
                visited[neighbor] = true;
                q.push(neighbor);
            }
        }
    }
    cout << endl;
}

int main() {
    int n = 6;
    vector<vector<int>> adj(n);
    // Edges: 0-1, 0-2, 1-3, 1-4, 2-5
    adj[0] = {1, 2}; adj[1] = {0, 3, 4};
    adj[2] = {0, 5}; adj[3] = {1};
    adj[4] = {1};    adj[5] = {2};
    bfs(adj, 0, n);
}
