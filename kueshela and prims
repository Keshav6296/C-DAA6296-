#include <iostream>
#include <vector>
#include <algorithm>
#include <climits>
using namespace std;

// ===== PRIM'S =====
void primMST(vector<vector<pair<int,int>>>& adj, int n) {
    vector<int> key(n, INT_MAX), parent(n, -1);
    vector<bool> inMST(n, false);
    key[0] = 0;
    for (int count = 0; count < n-1; count++) {
        int u = -1;
        for (int v = 0; v < n; v++)
            if (!inMST[v] && (u == -1 || key[v] < key[u])) u = v;
        inMST[u] = true;
        for (auto [v, w] : adj[u])
            if (!inMST[v] && w < key[v]) { key[v] = w; parent[v] = u; }
    }
    cout << "--- Prim's MST ---\nEdge\tWeight\n";
    int total = 0;
    for (int i = 1; i < n; i++) { cout << parent[i] << "-" << i << "\t" << key[i] << "\n"; total += key[i]; }
    cout << "Total: " << total << "\n\n";
}

// ===== KRUSKAL'S =====
struct Edge { int u, v, w; };

struct DSU {
    vector<int> parent, rank_;
    DSU(int n) : parent(n), rank_(n, 0) { for(int i=0;i<n;i++) parent[i]=i; }
    int find(int x) { return parent[x]==x ? x : parent[x]=find(parent[x]); }
    bool unite(int x, int y) {
        x=find(x); y=find(y); if(x==y) return false;
        if(rank_[x]<rank_[y]) swap(x,y);
        parent[y]=x; if(rank_[x]==rank_[y]) rank_[x]++;
        return true;
    }
};

void kruskalMST(vector<Edge>& edges, int n) {
    sort(edges.begin(), edges.end(), [](const Edge& a, const Edge& b){ return a.w < b.w; });
    DSU dsu(n);
    cout << "--- Kruskal's MST ---\nEdge\tWeight\n";
    int total = 0;
    for (auto& e : edges) {
        if (dsu.unite(e.u, e.v)) {
            cout << e.u << "-" << e.v << "\t" << e.w << "\n";
            total += e.w;
        }
    }
    cout << "Total: " << total << "\n";
}

int main() {
    int n = 5;
    vector<vector<pair<int,int>>> adj(n);
    vector<Edge> edges;
    auto addEdge = [&](int u, int v, int w) {
        adj[u].push_back({v,w}); adj[v].push_back({u,w});
        edges.push_back({u, v, w});
    };
    addEdge(0,1,2); addEdge(0,3,6); addEdge(1,2,3);
    addEdge(1,3,8); addEdge(1,4,5); addEdge(2,4,7); addEdge(3,4,9);
    primMST(adj, n);
    kruskalMST(edges, n);
}
